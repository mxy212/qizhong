<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F5F5F5">

    <!-- 顶部工具栏 -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="#FFFFFF"
        android:elevation="4dp"
        android:paddingHorizontal="16dp">

        <!-- 标题 -->
        <TextView
            android:id="@+id/tv_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:text="NotePad"
            android:textColor="#222222"
            android:textSize="20sp"
            android:textStyle="bold" />

        <!-- 按钮容器 -->
        <LinearLayout
            android:id="@+id/ll_buttons"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:orientation="horizontal">

            <!-- 搜索按钮 ID: btn_search -->
            <ImageView
                android:id="@+id/btn_search"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginEnd="12dp"
                android:src="@android:drawable/ic_menu_search"
                android:contentDescription="Search" />

            <!-- 切换布局按钮 ID: btn_switch_layout -->
            <ImageView
                android:id="@+id/btn_switch_layout"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginEnd="12dp"
                android:src="@android:drawable/ic_menu_sort_by_size"
                android:contentDescription="Switch Layout" />

            <!-- 添加笔记按钮 ID: btn_add_note -->
            <ImageView
                android:id="@+id/btn_add_note"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@android:drawable/ic_input_add"
                android:contentDescription="Add Note" />
        </LinearLayout>

        <!-- 搜索框 (默认隐藏) ID: note_search_view -->
        <SearchView
            android:id="@+id/note_search_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#FFFFFF"
            android:visibility="gone"
            android:queryHint="Search notes..."
            android:iconifiedByDefault="false" />

    </RelativeLayout>

    <!-- 笔记列表 ID: notes_recycler -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/notes_recycler"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="8dp"
        android:clipToPadding="false" />

</LinearLayout>