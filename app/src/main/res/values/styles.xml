<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- 基础应用主题 -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.DarkActionBar">
        <!-- Customize your theme here. -->
        <item name="colorPrimary">#3F51B5</item>
        <item name="colorPrimaryDark">#303F9F</item>
        <item name="colorAccent">#FF4081</item>
    </style>

    <!-- 浅色主题 -->
    <style name="AppTheme.Light" parent="AppTheme" />

    <!-- 深色主题 -->
    <style name="AppTheme.Dark" parent="Theme.AppCompat.NoActionBar">
        <item name="colorPrimary">@color/dark_bg</item>
        <item name="colorPrimaryDark">@android:color/black</item>
        <item name="colorAccent">@color/colorAccent</item>
        <item name="app_background">@color/dark_bg</item>
        <item name="note_card_bg">@color/dark_card</item>
        <item name="note_text_color">@android:color/white</item>
        <item name="android:windowBackground">@color/dark_bg</item>
    </style>

    <!-- NotePad 主主题（兼容原有应用） -->
    <style name="Theme.Notepad" parent="AppTheme.Light" />

    <!-- 对话框主题 -->
    <style name="Theme.Dialog" parent="Theme.AppCompat.Light.Dialog">
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorAccent">@color/colorAccent</item>
        <item name="android:windowMinWidthMajor">80%</item>
        <item name="android:windowMinWidthMinor">80%</item>
        <item name="android:background">?attr/app_background</item>
        <item name="android:textColor">?attr/note_text_color</item>
    </style>

    <!-- 简化版浅色主题 -->
    <style name="LightTheme" parent="AppTheme.Light" />

    <!-- 简化版深色主题 -->
    <style name="DarkTheme" parent="AppTheme.Dark" />
</resources>